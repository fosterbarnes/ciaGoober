<UserControl x:Class="CiaGoober.Tabs.GamesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:CiaGoober.Controls">
    <!-- DS, GBA, GB/GBC or NES tab. DataContext = GamesTabViewModel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- List spans both rows so its bottom edge lines up with the action bar. -->
        <controls:GameList Grid.RowSpan="2" />
        <controls:GameDetail Grid.Column="2" DataContext="{Binding SelectedGame}" />

        <Border Grid.Row="1"
                Grid.Column="2"
                Margin="0,12,0,0"
                Style="{StaticResource ActionBarPanelStyle}">
            <!-- Equal-width buttons that fill the bar. -->
            <UniformGrid Rows="1">
                <Button Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding AddRomsCommand}"
                        ToolTip="Choose ROM files to add; opens in the PC ROM Folder. Dropping files or folders on the window also adds them.">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Style="{StaticResource ButtonIconStyle}" Kind="Plus" />
                        <TextBlock Text="Add ROMs" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding ScanCommand}"
                        ToolTip="Add every ROM in the PC ROM Folder and its subfolders; asks for the folder when it is not set">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Style="{StaticResource ButtonIconStyle}" Kind="FolderSearchOutline" />
                        <TextBlock Text="{Binding SystemLabel, StringFormat=Scan {0} Folder}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding AutoFillAllCommand}"
                        ToolTip="Set missing banners and HOME Menu icons on every game in this tab from LaunchBox; art already chosen is kept">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Style="{StaticResource ButtonIconStyle}" Kind="AutoFix" />
                        <TextBlock Text="Auto-Fill All" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="0"
                        Command="{Binding BuildAllCommand}"
                        ToolTip="Build a CIA for every game in this tab">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Style="{StaticResource ButtonIconStyle}" Kind="Hammer" />
                        <TextBlock Text="{Binding SystemLabel, StringFormat=Build All {0}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
