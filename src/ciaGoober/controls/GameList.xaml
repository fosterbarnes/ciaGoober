<UserControl x:Class="CiaGoober.Controls.GameList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             UseLayoutRounding="True">
    <!-- DataContext = GamesTabViewModel; lists that tab's system only. -->
    <Border Style="{StaticResource ContentPanelStyle}" Padding="12">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Show games whose name contains this text"
                         AutomationProperties.Name="Filter games by name" />
                <TextBlock Margin="8,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Filter by name">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filter}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Settings store problem and the latest scan, Auto-Fill or remove summary. -->
            <Border DockPanel.Dock="Bottom"
                    Margin="0,8,0,0"
                    Padding="0,8,0,0"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Main.StatusMessage}" Value="{x:Null}" />
                                    <Condition Binding="{Binding Main.Settings.StoreError}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Margin="0,0,0,4"
                               Style="{StaticResource WarningMessageStyle}"
                               Text="{Binding Main.Settings.StoreError}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Margin="6,0,0,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding Main.DismissStatusCommand}"
                                Visibility="{Binding Visibility, ElementName=StatusText}"
                                ToolTip="Dismiss this message"
                                AutomationProperties.Name="Dismiss this message">
                            <md:PackIcon Kind="Close" />
                        </Button>
                        <TextBlock x:Name="StatusText"
                                   Margin="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MessageStyle}"
                                   Text="{Binding Main.StatusMessage}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <ListBox x:Name="GameRows"
                     SelectedItem="{Binding SelectedGame}"
                     AutomationProperties.Name="Games">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid AutomationProperties.Name="{Binding DisplayName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32"
                                    Height="32"
                                    Margin="0,0,10,0"
                                    CornerRadius="2"
                                    Background="{StaticResource ControlAltBrush}">
                                <Image Source="{Binding IconPreview}" Width="32" Height="32" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RomPath}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding StatusText}"
                                       ToolTip="{Binding Error}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource MetadataTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Built">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
